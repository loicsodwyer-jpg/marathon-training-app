# Frontend/public: safe to expose to the browser.
# Generated with: npm run generate:vapid
VITE_VAPID_PUBLIC_KEY=

# Server-only Vercel Function variables. Do not expose these in frontend code.
# VAPID_PUBLIC_KEY is usually the same value as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:loic.s.odwyer@gmail.com

# Supabase admin connection for Vercel Functions only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: restrict cross-origin API calls to one deployed origin.
# Same-origin app calls work without setting this.
PUSH_ALLOWED_ORIGIN=
